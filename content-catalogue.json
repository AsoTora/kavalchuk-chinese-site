, "text": "19"}, {"id": "text-182", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-183", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-184", "section": "Отзывы", "text": "20"}, {"id": "text-185", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-186", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-187", "section": "Отзывы", "text": "21"}, {"id": "text-188", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-189", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-190", "section": "Отзывы", "text": "22"}, {"id": "text-191", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-192", "section": "Отзывы", "text": "01 / 22"}, {"id": "text-193", "section": "Образование", "text": "05 /"}, {"id": "text-194", "section": "Образование", "text": "ОБРАЗОВАНИЕ И ДОСТИЖЕНИЯ"}, {"id": "text-195", "section": "Образование", "text": "Знания, за которыми"}, {"id": "text-196", "section": "Образование", "text": "стоит опыт."}, {"id": "text-197", "section": "Образование", "text": "2017–2021"}, {"id": "text-198", "section": "Образование", "text": "МГЛУ"}, {"id": "text-199", "section": "Образование", "text": "Минский государственный лингвистический университет · Минск"}, {"id": "text-200", "section": "Образование", "text": "Высшее образование: переводчик китайского и английского языков."}, {"id": "text-201", "section": "Образование", "text": "2020–2024"}, {"id": "text-202", "section": "Образование", "text": "МФПУ"}, {"id": "text-203", "section": "Образование", "text": "Московский финансово-промышленный университет «Синергия» · Москва"}, {"id": "text-204", "section": "Образование", "text": "Бакалавр лингвистики. Специальность: Теория и практика перевода."}, {"id": "text-205", "section": "Образование", "text": "Красный диплом."}, {"id": "text-206", "section": "Образование", "text": "2021–2025"}, {"id": "text-207", "section": "Образование", "text": "Шанхайский университет"}, {"id": "text-208", "section": "Образование", "text": "Shanghai University · 上海大学 · Шанхай"}, {"id": "text-209", "section": "Образование", "text": "ⓘ"}, {"id": "text-210", "section": "Образование", "text": "Бакалавриат менеджмента. Специальность: Бизнес-администрирование."}, {"id": "text-211", "section": "Образование", "text": "Выпустилась в числе лучших 10 студентов своей специальности."}, {"id": "text-212", "section": "Образование", "text": "Подробнее об образовании и достижениях"}, {"id": "text-213", "section": "Образование", "text": "+"}, {"id": "text-214", "section": "Образование", "text": "Стипендии и академические награды"}, {"id": "text-215", "section": "Образование", "text": "2020–2021"}, {"id": "text-216", "section": "Образование", "text": "Международная стипендия для преподавателей китайского языка"}, {"id": "text-217", "section": "Образование", "text": "国际中文教师奖学金"}, {"id": "text-218", "section": "Образование", "text": "Министерство образования КНР"}, {"id": "text-219", "section": "Образование", "text": "Стипендиальная программа для изучения и преподавания китайского языка от Министерства образования Китая с конкурсным отбором. Год изучения китайского языка в Университете Нинбо с полным финансированием. Я была единственной участницей из Беларуси, прошедшей отбор и поехавшей на эту программу."}, {"id": "text-220", "section": "Образование", "text": "2021–2025"}, {"id": "text-221", "section": "Образование", "text": "Государственная стипендия правительства Шанхая"}, {"id": "text-222", "section": "Образование", "text": "上海政府奖学金"}, {"id": "text-223", "section": "Образование", "text": "Правительство Шанхая  · Комитет по образованию Шанхая"}, {"id": "text-224", "section": "Образование", "text": "Конкурсная стипендия правительства Шанхая для иностранных студентов с высокими академическими результатами. По этой программе я училась на бакалавриате Шанхайского университета."}, {"id": "text-225", "section": "Образование", "text": "2021–2022"}, {"id": "text-226", "section": "Образование", "text": "Стипендиальная награда за академические достижения"}, {"id": "text-227", "section": "Образование", "text": "在校优秀生奖学金学业奖"}, {"id": "text-228", "section": "Образование", "text": "Институт международного образования Шанхайского университета"}, {"id": "text-229", "section": "Образование", "text": "Стипендиальная награда за выдающиеся академические успехи для лучших студентов Шанхайского университета."}, {"id": "text-230", "section": "Образование", "text": "Высшее образование"}, {"id": "text-231", "section": "Образование", "text": "2017–2021"}, {"id": "text-232", "section": "Образование", "text": "Минский государственный лингвистический университет (МГЛУ)"}, {"id": "text-233", "section": "Образование", "text": "Высшее образование: переводчик китайского и английского языков."}, {"id": "text-234", "section": "Образование", "text": "2020–2024"}, {"id": "text-235", "section": "Образование", "text": "Московский финансово-промышленный университет «Синергия»"}, {"id": "text-236", "section": "Образование", "text": "Бакалавр лингвистики. Специальность: Теория и практика перевода."}, {"id": "text-237", "section": "Образование", "text": "Диплом с отличием."}, {"id": "text-238", "section": "Образование", "text": "2021–2025"}, {"id": "text-239", "section": "Образование", "text": "Шанхайский университет (Shanghai University), Шанхай"}, {"id": "text-240", "section": "Образование", "text": "Бакалавриат менеджмента (BBA). Специальность: Бизнес-администрирование."}, {"id": "text-241", "section": "Образование", "text": "Обучение на китайском вместе с китайскими студентами, на равных условиях."}, {"id": "text-242", "section": "Образование", "text": "Выпустилась в числе лучших 10 студентов своей специальности."}, {"id": "text-243", "section": "Образование", "text": "Обучение по конкурсной стипендии правительства Шанхая для иностранных студентов с высокими академическими результатами. В период обучения также была удостоена премии за высокие академические результаты."}, {"id": "text-244", "section": "Образование", "text": "Сертификаты, стажировки и повышение квалификации"}, {"id": "text-245", "section": "Образование", "text": "2017–2019"}, {"id": "text-246", "section": "Образование", "text": "Курс китайского языка"}, {"id": "text-247", "section": "Образование", "text": "Институт Конфуция МГЛУ · Минск"}, {"id": "text-248", "section": "Образование", "text": "ⓘ"}, {"id": "text-249", "section": "Образование", "text": "Изучение китайского языка в университетском языковом центре."}, {"id": "text-250", "section": "Образование", "text": "Языковая практика и развитие базовых навыков общения."}, {"id": "text-251", "section": "Образование", "text": "2018"}, {"id": "text-252", "section": "Образование", "text": "Летняя программа по изучению китайского языка"}, {"id": "text-253", "section": "Образование", "text": "Юго-Восточный университет (Southeast University) · Нанкин"}, {"id": "text-254", "section": "Образование", "text": "ⓘ"}, {"id": "text-255", "section": "Образование", "text": "Краткосрочная программа изучения китайского языка и культуры для иностранных студентов."}, {"id": "text-256", "section": "Образование", "text": ""}, {"id": "text-257", "section": "Образование", "text": "2019–2020"}, {"id": "text-258", "section": "Образование", "text": "Курс китайского языка"}, {"id": "text-259", "section": "Образование", "text": "Институт Конфуция БНТУ · Минск"}, {"id": "text-260", "section": "Образование", "text": "Обучение китайскому языку в специализированном Институте Конфуция при Белорусском национальном техническом университете."}, {"id": "text-261", "section": "Образование", "text": ""}, {"id": "text-262", "section": "Образование", "text": "2019"}, {"id": "text-263", "section": "Образование", "text": "Летняя программа по изучению китайского языка"}, {"id": "text-264", "section": "Образование", "text": "Северо-Восточный университет (Northeastern University) · Шэньян"}, {"id": "text-265", "section": "Образование", "text": "ⓘ"}, {"id": "text-266", "section": "Образование", "text": "Успешно прошла 60-часовую программу китайского языка и культуры для иностранных студентов в 东北大学 и сдала все предусмотренные экзамены."}, {"id": "text-267", "section": "Образование", "text": ""}, {"id": "text-268", "section": "Образование", "text": "2020–2021"}, {"id": "text-269", "section": "Образование", "text": "Годовая программа по изучению китайского языка"}, {"id": "text-270", "section": "Образование", "text": "Университет Нинбо (Ningbo University) · Нинбо"}, {"id": "text-271", "section": "Образование", "text": "ⓘ"}, {"id": "text-272", "section": "Образование", "text": "Обучение по университетской программе китайского языка, в течение 2 семестров."}, {"id": "text-273", "section": "Образование", "text": "Полная государственная стипендия для международных преподавателей китайского языка International Chinese Language Teachers Scholarship), предоставленная Министерством образования КНР."}, {"id": "text-274", "section": "Образование", "text": "2022"}, {"id": "text-275", "section": "Образование", "text": "Программа инноваций и предпринимательства для иностранных специалистов"}, {"id": "text-276", "section": "Образование", "text": "Shanghai Overseas Returned Scholars Association"}, {"id": "text-277", "section": "Образование", "text": "Успешно прошла программу профессионального обучения в области инноваций и предпринимательства на китайском языке — для специалистов с опытом международного образования. Программа организована в рамках инициатив по развитию специального района Линьган Шанхайской зоны свободной торговли."}, {"id": "text-278", "section": "Образование", "text": ""}, {"id": "text-279", "section": "Образование", "text": "2026 — …"}, {"id": "text-280", "section": "Образование", "text": "Международная программа подготовки преподавателей китайского языка"}, {"id": "text-281", "section": "Образование", "text": "International Chinese Teacher Training Program"}, {"id": "text-282", "section": "Образование", "text": "Пекинский университет языка и культуры (BLCU) · Пекин"}, {"id": "text-283", "section": "Образование", "text": "ⓘ"}, {"id": "text-284", "section": "Образование", "text": "Специализированная программа профессиональной подготовки преподавателей китайского языка как иностранного, разработанная и реализуемая Пекинским университетом языка и культуры."}, {"id": "text-285", "section": "Образование", "text": "Программа сосредоточена на методике преподавания именно китайского языка: фонетика, лексика, грамматика, иероглифика."}, {"id": "text-286", "section": "Образование", "text": "2026"}, {"id": "text-287", "section": "Образование", "text": "Международный Сертификат TESOL/TEFL · 120 часов"}, {"id": "text-288", "section": "Образование", "text": "120-Hour TESOL/TEFL Certificate"}, {"id": "text-289", "section": "Образование", "text": "World TESOL Academy · Великобритания"}, {"id": "text-290", "section": "Образование", "text": "Успешно завершила 120-часовую программу профессиональной подготовки преподавателей иностранного языка."}, {"id": "text-291", "section": "Образование", "text": "Планирование уроков, развитие четырёх языковых навыков, мотивация учеников, оценка прогресса и онлайн-преподавание."}, {"id": "text-292", "section": "Образование", "text": "Сертификат с аккредитацией ACCREDITAT и The CPD Certification Service."}, {"id": "text-293", "section": "Образование", "text": "2026"}, {"id": "text-294", "section": "Образование", "text": "Обучение студентов с РАС и СДВГ"}, {"id": "text-295", "section": "Образование", "text": "Supporting Students with Autism and/or ADHD"}, {"id": "text-296", "section": "Образование", "text": "Europass Teacher Academy · Италия"}, {"id": "text-297", "section": "Образование", "text": "Повышение квалификации: 5-часовой курс для преподавателей, посвящённый особенностям обучения студентов с расстройствами аутистического спектра и синдромом дефицита внимания и гиперактивности."}, {"id": "text-298", "section": "Образование", "text": "Изучались особенности аутизма, индивидуальных стилей обучения и образовательных потребностей учащихся, методы педагогической коммуникации и развития социальных навыков, стратегии организации обучения и поддержки позитивного поведения."}, {"id": "text-299", "section": "Образование", "text": "2026"}, {"id": "text-300", "section": "Образование", "text": "Создание психологически комфортной и инклюзивной образовательной среды. Креативные методы преподавания"}, {"id": "text-301", "section": "Образование", "text": "Learning Out Loud: Well-being, Inclusion and Creativity"}, {"id": "text-302", "section": "Образование", "text": "Europass Teacher Academy"}, {"id": "text-303", "section": "Образование", "text": "Повышение квалификации в рамках программы Erasmus+, софинансируемой Европейским союзом."}, {"id": "text-304", "section": "Образование", "text": "15-часовая программа охватывала: инклюзивную образовательную среду (создание условий для участия каждого в учебном процессе), подходы к поддержанию психологического комфорта студентов, применение практик mindfulness (осознанности) в обучении, позитивное образование (развитие сильных сторон учащихся), креативные методы преподавания."}, {"id": "text-305", "section": "Образование", "text": "2026"}, {"id": "text-306", "section": "Образование", "text": "Конференция \"Иностранные языки и готовность к будущему\""}, {"id": "text-307", "section": "Образование", "text": "Czy nauka języków obcych może pomóc oswoić przyszłość?"}, {"id": "text-308", "section": "Образование", "text": "Фонд развития системы образования (FRSE) · Польша"}, {"id": "text-309", "section": "Образование", "text": "Сертификат участия в образовательной конференции, организованной FRSE и Варшавским центром образовательных инноваций в сотрудничестве с Посольством Испании в Польше в рамках Европейского дня языков."}, {"id": "text-310", "section": "Образование", "text": "8-часовая программа включала: социально-эмоциональное обучение (SEL) в преподавании иностранных языков, психологические аспекты языкового обучения, практика активного воспроизведения знаний, прагматика и коммуникативные стратегии."}, {"id": "text-311", "section": "Образование", "text": "Конкурсы, награды и университетская деятельность"}, {"id": "text-312", "section": "Образование", "text": "2021"}, {"id": "text-313", "section": "Образование", "text": "IX Международный фестиваль студентов в Нинбо"}, {"id": "text-314", "section": "Образование", "text": "Городской уровень: руководила командой иностранных студентов, представлявшей Университет Нинбо на международном студенческом фестивале в Университете Ноттингем на китайском языке. Удостоена официального свидетельства за выдающееся выступление."}, {"id": "text-315", "section": "Образование", "text": "2021"}, {"id": "text-316", "section": "Образование", "text": "Международный конкурс студенческих инновационных и предпринимательских проектов «Интернет+"}, {"id": "text-317", "section": "Образование", "text": "Провинциальный уровень: бронзовая награда в студенческом конкурсе инноваций и предпринимательства «互联网+» в провинции Чжэцзян."}, {"id": "text-318", "section": "Образование", "text": "Выступала в качестве капитана команды китайских студентов при разработке и защите технологического бизнес-проекта - умной ложки для людей с болезнью Альцгеймера."}, {"id": "text-319", "section": "Образование", "text": "Защита проекта проходила на китайском перед комиссией организаторов и инвесторов."}, {"id": "text-320", "section": "Образование", "text": "2022"}, {"id": "text-321", "section": "Образование", "text": "Конкурс по международной торговле"}, {"id": "text-322", "section": "Образование", "text": "Университетский уровень: награда «Шёлковый путь» в Конкурсе международной торговли в рамках состязания «Бизнес-элита Шанхайского университета — 2022»"}, {"id": "text-323", "section": "Образование", "text": "Конкурс включал 4 этапа: подготовку выставочного бизнес-плана, оформление виртуального выставочного стенда, презентацию продукта и моделирование торговых переговоров."}, {"id": "text-324", "section": "Образование", "text": "2022"}, {"id": "text-325", "section": "Образование", "text": "I место на Всекитайском конкурсе международной торговли"}, {"id": "text-326", "section": "Образование", "text": "Национальный (общекитайский) уровень: награда I степени в финале Всекитайского конкурса бизнес-лидеров среди студентов вузов — направление международной торговли, симуляция торговых операций (из ~2 500 участников)"}, {"id": "text-327", "section": "Образование", "text": "Представляла Шанхайский университет на китайском языке: в качестве капитана команды разработала и защитила бизнес-проект перед конкурсной комиссией. Награда присуждена за выдающиеся результаты в финале Всекитайского конкурса бизнес-мастерства среди студентов высших учебных заведений"}, {"id": "text-328", "section": "Образование", "text": "Среди организаторов — Китайский совет по содействию международной торговле и Китайская международная торговая палата."}, {"id": "text-329", "section": "Образование", "text": "2023"}, {"id": "text-330", "section": "Образование", "text": "Сертификат амбассадора интернациональных студентов"}, {"id": "text-331", "section": "Образование", "text": "Прошла конкурсный отбор среди лучших студентов университета и получила официальное назначение на должность международного студенческого амбассадора. International Student Ambassador — представитель международного студенческого сообщества университета. Работала в отделе по работе с иностранными студентами Института международного образования Шанхайского университета."}, {"id": "text-332", "section": "Образование", "text": "Обсудить вашу программу обучения"}, {"id": "text-333", "section": "Контакты и форма", "text": "06 /"}, {"id": "text-334", "section": "Контакты и форма", "text": "НАЧНЁМ С ВАШЕЙ ЦЕЛИ"}, {"id": "text-335", "section": "Контакты и форма", "text": "ВАШ КИТАЙСКИЙ НАЧИНАЕТСЯ ЗДЕСЬ"}, {"id": "text-336", "section": "Контакты и форма", "text": "Позвольте себе"}, {"id": "text-337", "section": "Контакты и форма", "text": "больше."}, {"id": "text-338", "section": "Контакты и форма", "text": "Расскажите, зачем вам китайский."}, {"id": "text-339", "section": "Контакты и форма", "text": "Я свяжусь с вами и предложу, с чего начать."}, {"id": "text-340", "section": "Контакты и форма", "text": "Telegram · @catforchina"}, {"id": "text-341", "section": "Контакты и форма", "text": "Nihao"}, {"id": "text-342", "section": "Контакты и форма", "text": "Now"}, {"id": "text-343", "section": "Контакты и форма", "text": "."}, {"id": "text-344", "section": "Контакты и форма", "text": "ШКОЛА КИТАЙСКОГО ЯЗЫКА"}, {"id": "text-345", "section": "Контакты и форма", "text": "Китайский для ваших больших планов."}, {"id": "text-346", "section": "Контакты и форма", "text": "© 2026"}, {"id": "text-347", "section": "Контакты и форма", "text": "Отзыв ученика"}, {"id": "text-348", "section": "Контакты и форма", "text": "Закрыть"}, {"id": "text-349", "section": "Подписи и доступность", "text": "NihaoNow — на главную"}, {"id": "text-350", "section": "Подписи и доступность", "text": "NihaoNow"}, {"id": "text-351", "section": "Подписи и доступность", "text": "Основная навигация"}, {"id": "text-352", "section": "Подписи и доступность", "text": "Мой уровень HSK 1, перейти к анкете"}, {"id": "text-353", "section": "Подписи и доступность", "text": "Мой уровень HSK 2, перейти к анкете"}, {"id": "text-354", "section": "Подписи и доступность", "text": "Мой уровень HSK 3, перейти к анкете"}, {"id": "text-355", "section": "Подписи и доступность", "text": "Мой уровень HSK 4, перейти к анкете"}, {"id": "text-356", "section": "Подписи и доступность", "text": "Мой уровень HSK 5, перейти к анкете"}, {"id": "text-357", "section": "Подписи и доступность", "text": "Мой уровень HSK 6, перейти к анкете"}, {"id": "text-358", "section": "Подписи и доступность", "text": "Карусель отзывов. Можно перелистывать кнопками, клавишами или свайпом"}, {"id": "text-359", "section": "Подписи и доступность", "text": "