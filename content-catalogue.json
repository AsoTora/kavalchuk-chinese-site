[{"id": "text-1", "section": "Шапка сайта", "text": "Nihao"}, {"id": "text-2", "section": "Шапка сайта", "text": "Now"}, {"id": "text-3", "section": "Шапка сайта", "text": "."}, {"id": "text-4", "section": "Шапка сайта", "text": "ШКОЛА КИТАЙСКОГО ЯЗЫКА"}, {"id": "text-5", "section": "Шапка сайта", "text": "Обо мне"}, {"id": "text-6", "section": "Шапка сайта", "text": "Тарифы"}, {"id": "text-7", "section": "Шапка сайта", "text": "Ваши цели"}, {"id": "text-8", "section": "Шапка сайта", "text": "Отзывы"}, {"id": "text-9", "section": "Шапка сайта", "text": "Образование"}, {"id": "text-10", "section": "Шапка сайта", "text": "Оставить заявку"}, {"id": "text-11", "section": "Первый экран", "text": "КИТАЙСКИЙ ЯЗЫК · ПЕРСОНАЛЬНОЕ ОБУЧЕНИЕ"}, {"id": "text-12", "section": "Первый экран", "text": "Время учить"}, {"id": "text-13", "section": "Первый экран", "text": "китайский —"}, {"id": "text-14", "section": "Первый экран", "text": "сейчас."}, {"id": "text-15", "section": "Первый экран", "text": "Для жизни, в которой"}, {"id": "text-16", "section": "Первый экран", "text": "есть место большим планам."}, {"id": "text-17", "section": "Первый экран", "text": "Забронировать место"}, {"id": "text-18", "section": "Первый экран", "text": "↗"}, {"id": "text-19", "section": "Первый экран", "text": "从现在开始 · НАЧНИТЕ СЕЙЧАС"}, {"id": "text-20", "section": "Первый экран", "text": "ЕКАТЕРИНА КАВАЛЬЧУК"}, {"id": "text-21", "section": "Первый экран", "text": "С НУЛЯ ДО HSK 6"}, {"id": "text-22", "section": "Первый экран", "text": "ОНЛАЙН · ИНДИВИДУАЛЬНО"}, {"id": "text-23", "section": "Первый экран", "text": "10 лет"}, {"id": "text-24", "section": "Первый экран", "text": "преподаю языки"}, {"id": "text-25", "section": "Первый экран", "text": "5 лет"}, {"id": "text-26", "section": "Первый экран", "text": "жизни в Китае"}, {"id": "text-27", "section": "Первый экран", "text": "HSK 1–6"}, {"id": "text-28", "section": "Первый экран", "text": "все уровни"}, {"id": "text-29", "section": "Первый экран", "text": "上海大学"}, {"id": "text-30", "section": "Первый экран", "text": "выпускница"}, {"id": "text-31", "section": "Обо мне", "text": "01 /"}, {"id": "text-32", "section": "Обо мне", "text": "ВАШ ПРЕПОДАВАТЕЛЬ"}, {"id": "text-33", "section": "Обо мне", "text": "语言打开新的世界"}, {"id": "text-34", "section": "Обо мне", "text": "Язык открывает новый мир"}, {"id": "text-35", "section": "Обо мне", "text": "中文"}, {"id": "text-36", "section": "Обо мне", "text": "с вами"}, {"id": "text-37", "section": "Обо мне", "text": "ПРИЯТНО ПОЗНАКОМИТЬСЯ"}, {"id": "text-38", "section": "Обо мне", "text": "Екатерина"}, {"id": "text-39", "section": "Обо мне", "text": "Кавальчук."}, {"id": "text-40", "section": "Обо мне", "text": "Китайский, который становится"}, {"id": "text-41", "section": "Обо мне", "text": "частью вашей жизни."}, {"id": "text-42", "section": "Обо мне", "text": "Я прожила в Китае пять лет, училась на китайском вместе с китайскими студентами и выпустилась в топ-10 своей специальности в Шанхайском университете."}, {"id": "text-43", "section": "Обо мне", "text": "10 лет преподаю языки и 8 лет работаю переводчиком. Поэтому на занятиях мы соединяем язык с реальными задачами: разговором, учёбой, бизнесом и культурой."}, {"id": "text-44", "section": "Обо мне", "text": "Ваш план начинается с вашей цели. Подберём темп, разберём пробелы и будем последовательно двигаться от первых фраз к уверенному китайскому."}, {"id": "text-45", "section": "Обо мне", "text": "Образование и достижения"}, {"id": "text-46", "section": "Тарифы", "text": "02 /"}, {"id": "text-47", "section": "Тарифы", "text": "ФОРМАТЫ И ТАРИФЫ"}, {"id": "text-48", "section": "Тарифы", "text": "Ваш следующий уровень"}, {"id": "text-49", "section": "Тарифы", "text": "Китайский."}, {"id": "text-50", "section": "Тарифы", "text": "На ваших условиях."}, {"id": "text-51", "section": "Тарифы", "text": "Персональная работа с вашим запросом."}, {"id": "text-52", "section": "Тарифы", "text": "Выберите, с чего начнём."}, {"id": "text-53", "section": "Тарифы", "text": "01"}, {"id": "text-54", "section": "Тарифы", "text": "Разговорный клуб"}, {"id": "text-55", "section": "Тарифы", "text": "Живой китайский в компании тех, кто тоже хочет говорить увереннее."}, {"id": "text-56", "section": "Тарифы", "text": "Обсуждения и разговорная практика"}, {"id": "text-57", "section": "Тарифы", "text": "Лексика для живого общения"}, {"id": "text-58", "section": "Тарифы", "text": "Группа с учётом вашего уровня"}, {"id": "text-59", "section": "Тарифы", "text": "от 12 $"}, {"id": "text-60", "section": "Тарифы", "text": "В разговорный клуб"}, {"id": "text-61", "section": "Тарифы", "text": "ВАШ"}, {"id": "text-62", "section": "Тарифы", "text": "ЛИЧНЫЙ"}, {"id": "text-63", "section": "Тарифы", "text": "ПЛАН"}, {"id": "text-64", "section": "Тарифы", "text": "02"}, {"id": "text-65", "section": "Тарифы", "text": "Личный маршрут"}, {"id": "text-66", "section": "Тарифы", "text": "Индивидуальные занятия — от первого иероглифа до HSK 6."}, {"id": "text-67", "section": "Тарифы", "text": "План под ваш уровень и цель"}, {"id": "text-68", "section": "Тарифы", "text": "Разговорная практика"}, {"id": "text-69", "section": "Тарифы", "text": "Грамматика, лексика и письмо"}, {"id": "text-70", "section": "Тарифы", "text": "Задания и обратная связь"}, {"id": "text-71", "section": "Тарифы", "text": "от 35 $"}, {"id": "text-72", "section": "Тарифы", "text": "Выбрать свой путь"}, {"id": "text-73", "section": "Тарифы", "text": "03"}, {"id": "text-74", "section": "Тарифы", "text": "Групповые занятия"}, {"id": "text-75", "section": "Тарифы", "text": "Учимся вместе и движемся по общей программе — с практикой и поддержкой."}, {"id": "text-76", "section": "Тарифы", "text": "Занятия в группе вашего уровня"}, {"id": "text-77", "section": "Тарифы", "text": "Системная программа обучения"}, {"id": "text-78", "section": "Тарифы", "text": "Диалоги и совместная практика"}, {"id": "text-79", "section": "Тарифы", "text": "от 12 $"}, {"id": "text-80", "section": "Тарифы", "text": "Подобрать группу"}, {"id": "text-81", "section": "Тарифы", "text": "Итоговая стоимость зависит от программы и формата занятий."}, {"id": "text-82", "section": "Цели обучения", "text": "03 /"}, {"id": "text-83", "section": "Цели обучения", "text": "С ЧЕМ Я РАБОТАЮ"}, {"id": "text-84", "section": "Цели обучения", "text": "У вас есть цель."}, {"id": "text-85", "section": "Цели обучения", "text": "У нас будет план."}, {"id": "text-86", "section": "Цели обучения", "text": "От первого знакомства с языком"}, {"id": "text-87", "section": "Цели обучения", "text": "до задач, которые меняют вашу жизнь."}, {"id": "text-88", "section": "Цели обучения", "text": "01"}, {"id": "text-89", "section": "Цели обучения", "text": "Китайский с нуля и дальше"}, {"id": "text-90", "section": "Цели обучения", "text": "Поставим произношение, научимся читать иероглифы и строить первые диалоги. Если вы уже учились, найдём пробелы и соберём понятную систему."}, {"id": "text-91", "section": "Цели обучения", "text": "ИНДИВИДУАЛЬНЫЙ ПЛАН · HSK 1–6"}, {"id": "text-92", "section": "Цели обучения", "text": "02"}, {"id": "text-93", "section": "Цели обучения", "text": "Подготовка к HSK 1–6"}, {"id": "text-94", "section": "Цели обучения", "text": "Лексика и грамматика нужного уровня, аудирование, чтение и письмо. Разберём формат заданий и будем практиковаться с учётом вашего экзамена и сроков."}, {"id": "text-95", "section": "Цели обучения", "text": "ЭКЗАМЕН · СИСТЕМА · ПРАКТИКА"}, {"id": "text-96", "section": "Цели обучения", "text": "03"}, {"id": "text-97", "section": "Цели обучения", "text": "Китайский для бизнеса"}, {"id": "text-98", "section": "Цели обучения", "text": "Деловое общение, встречи, презентации и переговоры. Научимся выражать свои мысли точно и учитывать особенности общения с китайскими партнёрами."}, {"id": "text-99", "section": "Цели обучения", "text": "ПЕРЕГОВОРЫ · ДЕЛОВАЯ ПЕРЕПИСКА"}, {"id": "text-100", "section": "Цели обучения", "text": "04"}, {"id": "text-101", "section": "Цели обучения", "text": "Поставщики и закупки в Китае"}, {"id": "text-102", "section": "Цели обучения", "text": "Запрос цены, характеристики товара, сроки, условия оплаты и поставки. Разберём лексику вашей сферы и потренируем общение с поставщиками на рабочих примерах."}, {"id": "text-103", "section": "Цели обучения", "text": "ТОВАРЫ · ЗАКАЗЫ · РАБОЧИЕ ДИАЛОГИ"}, {"id": "text-104", "section": "Цели обучения", "text": "05"}, {"id": "text-105", "section": "Цели обучения", "text": "Поступление в китайский вуз"}, {"id": "text-106", "section": "Цели обучения", "text": "Языковая подготовка для учёбы на китайском: экзамен, собеседование, академическая лексика и повседневное общение. Мой собственный опыт обучения в Китае помогает подготовиться к новой среде."}, {"id": "text-107", "section": "Цели обучения", "text": "УНИВЕРСИТЕТ · АКАДЕМИЧЕСКИЙ КИТАЙСКИЙ"}, {"id": "text-108", "section": "Цели обучения", "text": "06"}, {"id": "text-109", "section": "Цели обучения", "text": "Жизнь, путешествия и общение"}, {"id": "text-110", "section": "Цели обучения", "text": "Разговорный китайский для ваших ситуаций: знакомство, поездка, быт, работа и общение с друзьями. Развиваем понимание на слух и уверенность в разговоре."}, {"id": "text-111", "section": "Цели обучения", "text": "ЖИВОЙ ЯЗЫК · КУЛЬТУРА · УВЕРЕННОСТЬ"}, {"id": "text-112", "section": "Цели обучения", "text": "ВАШ УРОВЕНЬ — НАША ТОЧКА СТАРТА"}, {"id": "text-113", "section": "Цели обучения", "text": "HSK 1"}, {"id": "text-114", "section": "Цели обучения", "text": "2"}, {"id": "text-115", "section": "Цели обучения", "text": "3"}, {"id": "text-116", "section": "Цели обучения", "text": "4"}, {"id": "text-117", "section": "Цели обучения", "text": "5"}, {"id": "text-118", "section": "Цели обучения", "text": "6"}, {"id": "text-119", "section": "Цели обучения", "text": "Начните с того места, где вы сейчас."}, {"id": "text-120", "section": "Отзывы", "text": "04 /"}, {"id": "text-121", "section": "Отзывы", "text": "ОТЗЫВЫ И РЕЗУЛЬТАТЫ"}, {"id": "text-122", "section": "Отзывы", "text": "Как это было"}, {"id": "text-123", "section": "Отзывы", "text": "у моих учеников."}, {"id": "text-124", "section": "Отзывы", "text": "Отзывы о занятиях и результаты HSK —"}, {"id": "text-125", "section": "Отзывы", "text": "в сообщениях самих учеников."}, {"id": "text-126", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-127", "section": "Отзывы", "text": "01"}, {"id": "text-128", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-129", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-130", "section": "Отзывы", "text": "02"}, {"id": "text-131", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-132", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-133", "section": "Отзывы", "text": "03"}, {"id": "text-134", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-135", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-136", "section": "Отзывы", "text": "04"}, {"id": "text-137", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-138", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-139", "section": "Отзывы", "text": "05"}, {"id": "text-140", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-141", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-142", "section": "Отзывы", "text": "06"}, {"id": "text-143", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-144", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-145", "section": "Отзывы", "text": "07"}, {"id": "text-146", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-147", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-148", "section": "Отзывы", "text": "08"}, {"id": "text-149", "section": "Отзывы", "text": "Увеличить для чтения"}, {"id": "text-150", "section": "Отзывы", "text": "ОТЗЫВ / РЕЗУЛЬТАТ"}, {"id": "text-151",